# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS=https://forest-fire-prediction-psi.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Obtain a key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: shared rate limiting across multiple backend instances.
REDIS_URL=

# Keep API documentation disabled in production.
DISABLE_API_DOCS=true
